{
  "name": "hmr-middleware-rolldown-spike",
  "private": true,
  "type": "module",
  "dependencies": {
    "@remix-run/component": "workspace:*",
    "@remix-run/fetch-router": "workspace:*",
    "@remix-run/node-fetch-server": "workspace:*",
    "@remix-run/static-middleware": "workspace:*"
  },
  "devDependencies": {
    "@remix-run/hmr-middleware": "workspace:*",
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "rolldown": "1.0.0-beta.60",
    "tsx": "catalog:"
  },
  "scripts": {
    "dev": "pnpm run --filter \".\" --parallel \"/^dev:/\"",
    "dev:server": "NODE_ENV=development tsx watch server.ts",
    "dev:build": "NODE_ENV=development rolldown --config rolldown.config.ts --watch",
    "start": "NODE_ENV=production tsx server.ts",
    "build": "NODE_ENV=production rolldown --config rolldown.config.ts",
    "clean": "rm -rf public/assets",
    "test": "tsx --test",
    "typecheck": "tsgo --noEmit"
  }
}
