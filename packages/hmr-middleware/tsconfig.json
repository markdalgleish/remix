{
  "compilerOptions": {
    "strict": true,
    "target": "ESNext",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noEmit": true,
    "skipLibCheck": true,
    "jsx": "react-jsx",
    "jsxImportSource": "@remix-run/component"
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "test/e2e/**/*.ts",
    "test/fixtures/build.ts",
    "playwright.config.ts"
  ]
}
